# ─────────────────────────── إعدادات «حوّل» ───────────────────────────
# انسخ هذا الملف إلى .env ثم عبّئه:  cp .env.example .env

# ── قاعدة البيانات ────────────────────────────────────────────────
# PostgreSQL. على Railway يُحقَن تلقائيًا عند ربط قاعدة البيانات —
# لا تضبطه يدويًا هناك.
DATABASE_URL="postgresql://user:pass@localhost:5432/hawwil?schema=public"
#
# للتطوير المحلي بلا خادم Postgres: بدّل provider في
# prisma/schema.prisma إلى "sqlite" واستخدم:
# DATABASE_URL="file:./dev.db"

# ── الأمان ────────────────────────────────────────────────────────
# إلزامي. ولّد قيمة عشوائية بـ:  openssl rand -hex 32
APP_SECRET=""

# العنوان العام للتطبيق — يُستخدم في فحص CSRF وروابط QR.
# على Railway اتركه فارغًا: يُشتق تلقائيًا من RAILWAY_PUBLIC_DOMAIN.
APP_URL="http://localhost:3000"

# ── البريد (رموز التحقق) ──────────────────────────────────────────
# اتركها فارغة في التطوير: تُطبع الرموز في طرفية الخادم.
# في الإنتاج إلزامية، وإلا رفض التطبيق إرسال الرموز.
#
# لتفعيلها: عبّئ القيم أدناه فقط. nodemailer مثبّت والكود جاهز.
# مزوّدون مجانيون للبداية: Resend أو Brevo أو Gmail (بكلمة مرور تطبيق).
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="حوّل <no-reply@example.com>"

# ── بوابة الدفع (اشتراك المنصة فقط) ───────────────────────────────
# manual  = بدون بوابة خارجية؛ الطلب يُسجَّل ويفعّله المدير من /admin
# moyasar = تكامل جاهز (يحتاج المفاتيح أدناه)
# tap / stripe = هيكل جاهز يحتاج إكمال نقاط النهاية في src/lib/payments.ts
PAYMENTS_PROVIDER="manual"
PAYMENTS_SECRET_KEY=""
PAYMENTS_WEBHOOK_SECRET=""

# ── الباقات: الحدود والأسعار (قابلة للتعديل بلا لمس الكود) ─────────
FREE_MAX_ACCOUNTS="3"
PRO_MAX_ACCOUNTS="30"
PRO_PRICE_HALALAS="790"      # 7.90 ر.س
PRO_PRICE_WAS_HALALAS="1800" # السعر المشطوب — 0 يلغي عرض الخصم
PRO_CURRENCY="SAR"

# ── الإدارة ───────────────────────────────────────────────────────
# بُرد تُرقّى تلقائيًا إلى ADMIN عند أول تسجيل دخول (افصل بفاصلة)
ADMIN_EMAILS=""

# ── بريد التواصل النظامي ──────────────────────────────────────────
# يُعرض في سياسة الخصوصية وشروط الاستخدام. سياسة الخصوصية تَعِد بالرد
# خلال 30 يومًا على طلبات الوصول والتصحيح والحذف — فليكن صندوقًا تقرأه
# فعلًا. إن تُرك فارغًا يسقط إلى أول بريد في ADMIN_EMAILS، وإن خلا
# الاثنان ظهر تحذير في الوثيقتين.
CONTACT_EMAIL=""

# ── دخول مؤقت بكلمة مرور (طوارئ) ──────────────────────────────────
# مخرج لصاحب المنصة قبل تفعيل SMTP. مُطفأ افتراضيًا.
#
# ⚠️ احذف ALLOW_PASSWORD_LOGIN فور عمل البريد.
#
# يخص حسابًا واحدًا فقط (OWNER_EMAIL) — لا تسجيل ولا استعادة كلمة مرور.
# المحاولات محدودة: 5 لكل بريد و10 لكل IP كل 15 دقيقة، ثم حظر ساعة.
# القيمة الوحيدة التي تفعّله هي true — أي قيمة أخرى تبقيه مطفأ
ALLOW_PASSWORD_LOGIN=""
OWNER_EMAIL=""
OWNER_PASSWORD=""   # 12 حرفًا فأكثر
