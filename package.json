{
  "name": "hawwil",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "prisma migrate deploy || echo '⚠️  فشلت الهجرة — راجع DATABASE_URL'; next start -H 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
